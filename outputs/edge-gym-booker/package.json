{
  "name": "sjtu-edge-gym-booker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "node booker.mjs --login",
    "auth": "node booker.mjs --check-auth",
    "check": "node booker.mjs --check-config",
    "show-time": "node booker.mjs --show-release",
    "test": "node booker.mjs --self-test",
    "test:submission": "node --test submission-response.test.mjs",
    "test:submission-browser": "node submission-regression.mjs",
    "test:badminton": "node badminton-regression.mjs",
    "orders": "node booker.mjs --inspect-orders",
    "book": "node booker.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
